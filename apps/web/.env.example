# Copy to .env.local and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: free key from https://fdc.nal.usda.gov/api-key-signup for generic-food search.
# Without it the shared DEMO_KEY is used, which only allows a few searches per hour.
VITE_USDA_API_KEY=
