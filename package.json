{
  "name": "gymbro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gymbro/web",
    "build": "npm run build -w @gymbro/web",
    "test": "npm run test -w @gymbro/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
